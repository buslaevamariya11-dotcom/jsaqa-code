{
  "name": "cypress-test",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",

    "test:desktop:headless": "cypress run --config-file cypress.config.js --browser electron",
    "test:desktop:headed": "cypress run --config-file cypress.config.js --browser chrome --headed",
    "test:mobile:headless": "cypress run --config-file cypress.mobile.config.js --browser electron",
    "test:mobile:headed": "cypress run --config-file cypress.mobile.config.js --browser chrome --headed"
  },
